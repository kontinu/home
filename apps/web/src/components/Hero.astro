---
import { homepageContent } from "../content/homepage";

const { hero } = homepageContent;
---

<section class="hero">
  <div class="container-wide">
    <div class="hero__panel">
      <div class="hero__grid">
        <div class="hero__content">
          <span class="eyebrow">{hero.eyebrow}</span>
          <h1 class="hero__title">
            <span>{hero.titleLines[0]}</span>
            <span>
              {hero.titleLines[1]} <em>{hero.titleAccent}</em>
            </span>
            <span>{hero.titleLines[2]}</span>
          </h1>
          <p class="hero__lede">{hero.lede}</p>

          <div class="hero__actions">
            <a class="button" href={hero.primaryAction.href}>{hero.primaryAction.label}</a>
            <a class="button-secondary" href={hero.secondaryAction.href}>
              {hero.secondaryAction.label}
            </a>
          </div>

          <div class="hero__meta" aria-label="Puntos clave">
            {hero.meta.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>

        <aside class="hero__system" aria-label="Resumen visual de propuesta de valor">
          <div class="hero__orbital">
            <span class="hero__orbit hero__orbit--small"></span>
            <span class="hero__orbit hero__orbit--medium"></span>
            <span class="hero__orbit hero__orbit--large"></span>
            <span class="hero__node hero__node--alpha"></span>
            <span class="hero__node hero__node--beta"></span>
            <span class="hero__node hero__node--gamma"></span>
            <span class="hero__core" aria-hidden="true"></span>
          </div>

          <div class="hero__panels">
            {hero.panels.map((panel) => (
              <div class="hero__panel-card">
                <span class="hero__panel-kicker">{panel.kicker}</span>
                <h2 class="hero__panel-title">{panel.title}</h2>
                <p class="hero__panel-body">{panel.body}</p>
              </div>
            ))}
          </div>
        </aside>
      </div>
    </div>
  </div>
</section>
