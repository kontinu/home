---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BootcampCard from "../../components/BootcampCard.astro";
import { getBootcamps } from "../../lib/offering-content";

const bootcamps = await getBootcamps();
---

<BaseLayout
  title="Bootcamps | Kontinu"
  description="Bootcamps técnicos corporativos de Kontinu para cloud, containers, Kubernetes y prácticas DevOps."
>
  <section class="section">
    <div class="container-wide">
      <SectionHeading
        eyebrow="Bootcamps"
        level="h1"
        title="Bootcamps técnicos para convertir conceptos en práctica operativa."
        body="Rutas corporativas para squads, platform teams y liderazgo técnico que necesitan elevar criterio, alinear lenguaje y llevar el aprendizaje al trabajo diario."
      />

      <div class="collection-hero surface-panel">
        <div class="collection-hero__content">
          <p class="collection-hero__copy">
            Diseñamos experiencias formativas pensadas para contexto enterprise: cohortes
            internas, workshops intensivos y acompañamiento posterior para transformar teoría en
            decisiones reales.
          </p>
          <div class="collection-hero__actions">
            <a
              class="button-secondary"
              href="mailto:hola@kontinu.io?subject=Informaci%C3%B3n%20sobre%20bootcamps%20Kontinu"
            >
              Solicitar información
            </a>
            <a
              class="button"
              href="mailto:hola@kontinu.io?subject=Inscripci%C3%B3n%20a%20bootcamp%20Kontinu"
            >
              Inscribirme
            </a>
          </div>
        </div>

        <ul class="service-list">
          <li>Bootcamps aplicados a equipos reales, no cursos genéricos.</li>
          <li>Contenidos adaptables por rol, nivel y momento operativo.</li>
          <li>Una ruta clara entre upskilling, práctica y adopción posterior.</li>
        </ul>
      </div>

      {
        bootcamps.length > 0 ? (
          <div class="offering-grid">
            {bootcamps.map((bootcamp) => (
              <BootcampCard bootcamp={bootcamp} />
            ))}
          </div>
        ) : (
          <article class="empty-state-card">
            <h2 class="offering-card__title">Estamos armando la oferta formativa.</h2>
            <p class="offering-card__body">
              Si quieres revisar opciones para tu equipo desde ya, te compartimos el enfoque y
              definimos juntos el formato.
            </p>
            <a
              class="button-secondary"
              href="mailto:hola@kontinu.io?subject=Informaci%C3%B3n%20sobre%20bootcamps%20Kontinu"
            >
              Solicitar información
            </a>
          </article>
        )
      }
    </div>
  </section>

  <CtaBand
    title="¿Buscas elevar capacidades sin separar al equipo del trabajo real?"
    body="Bootcamps está orientado a formación aplicada: alineamos lenguaje, reforzamos criterio y convertimos el aprendizaje en una práctica útil para la operación."
    actions={[
      {
        href: "mailto:hola@kontinu.io?subject=Informaci%C3%B3n%20sobre%20bootcamps%20Kontinu",
        label: "Solicitar información",
        variant: "secondary"
      },
      {
        href: "mailto:hola@kontinu.io?subject=Inscripci%C3%B3n%20a%20bootcamp%20Kontinu",
        label: "Inscribirme"
      }
    ]}
  />
</BaseLayout>
